{
  "name": "@landing-optimizer/api",
  "version": "0.1.0",
  "description": "Landing Optimizer control-plane API (NestJS + Fastify).",
  "license": "UNLICENSED",
  "private": true,
  "engines": { "node": "^22.22.3 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "tenant:create": "ts-node src/modules/team/provision-tenant.ts",
    "clickhouse:migrate": "ts-node src/modules/analytics/clickhouse/migrate.ts"
  },
  "dependencies": {
    "@clickhouse/client": "^1.4.0",
    "@fastify/helmet": "^13.2.0",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-fastify": "^12.5.0",
    "@prisma/client": "^5.16.0",
    "argon2": "^0.40.3",
    "ioredis": "^5.4.1",
    "prisma": "^5.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuidv7": "^0.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@types/node": "^22.20.5",
    "eslint": "^9.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^11.0.0"
  }
}
